move r1 12
j endif2
else2:
add r1 r1 24
endif2:
else1:
jal aim
j while2
endwhile2:
while3:
l r2 d0 SignalStrength
bgt r2 1 skip2
j endwhile3
skip2:
s d5 Setting STR("Tuning")
l r2 d0 SignalStrength
div r2 r2 2
floor r2 r2
