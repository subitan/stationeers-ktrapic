j while3
endwhile3:
l r0 d0 SignalStrength
beq r0 -1 while1
s d5 Setting STR("Done!")
s d1 Open 0
while4:
l r0 d1 Open
bnez r0 endwhile4
sleep 2
j while4
endwhile4:
j while1
aim:
s d0 Horizontal r0
s d0 Vertical r1
while5:
l r2 d0 Idle
bnez r2 endwhile5
yield
j while5
endwhile5:
move r2 0
while6:
l r4 d0 SignalStrength
bne r4 -1 endwhile6
blt r2 20 skip3
j endwhile6
skip3:
