s d0 Vertical 45
s d0 Horizontal 0
while1:
l r0 d0 SignalStrength
bne r0 -1 endwhile1
push STR("init.")
jal debug
sleep 0.25
push STR("init ")
jal debug
jal display
j while1
endwhile1:
while2:
l r0 d0 SignalStrength
blt r0 2 skip1
j endwhile2
skip1:
push STR("Scan")
jal debug
push 20
push 0
jal moveDish
j while2
endwhile2:
while3:
l r0 d0 SignalStrength
blt r0 97 skip2
j endwhile3
skip2:
push STR("Fine")
jal debug
push 0
push 1
jal adjust
push 0
push -1
jal adjust
push 1
push 0
jal adjust
push -1
push 0
jal adjust
jal display
j while3
endwhile3:
push STR("Done!")
jal debug
j end
debug:
pop r0
s d5 Mode 10
s d5 Setting r0
sleep 2
j ra
display:
l r0 d0 SignalStrength
s d2 Setting r0
l r0 d0 Horizontal
s d3 Setting r0
j ra
moveDish:
pop r0
pop r1
push ra
l r2 d0 Horizontal
add r1 r2 r1
s d0 Horizontal r1
l r1 d0 Vertical
add r0 r1 r0
s d0 Vertical r0
while4:
l r0 d0 SignalStrength
bne r0 -1 endwhile4
jal display
push STR("move.")
jal debug
sleep 0.25
push STR("move ")
jal debug
j while4
endwhile4:
push STR("stop")
jal debug
sleep 1
jal display
pop ra
j ra
adjust:
pop r0
pop r1
push ra
l r2 d0 SignalStrength
push r0
push r1
push r2
push r1
push r0
jal moveDish
pop r2
pop r1
pop r0
l r3 d0 SignalStrength
blt r3 r2 skip3
j else1
skip3:
mul r1 r1 -1
mul r0 r0 -1
push r1
push r0
jal moveDish
else1:
pop ra
j ra
end:
