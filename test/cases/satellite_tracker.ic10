s d5 Mode 10
while1:
move r0 0
move r1 45
jal aim
while2:
l r2 d0 SignalStrength
bne r2 -1 endwhile2
s d5 Setting STR("Scan")
add r0 r0 20
div r2 r0 360
trunc r2 r2
mul r2 r2 360
sub r0 r0 r2
jal aim
j while2
endwhile2:
while3:
l r2 d0 SignalStrength
bgt r2 1 skip1
j endwhile3
skip1:
s d5 Setting STR("Tuning")
l r2 d0 SignalStrength
div r2 r2 2
floor r2 r2
max r2 1 r2
move r3 0
move r4 r2
jal fineTune
mul r4 r2 -1
move r3 0
jal fineTune
move r3 r2
move r4 0
jal fineTune
mul r3 r2 -1
move r4 0
jal fineTune
j while3
endwhile3:
l r0 d0 SignalStrength
beq r0 -1 while1
s d5 Setting STR("Done!")
s d1 Open 0
while4:
l r0 d1 Open
bnez r0 endwhile4
sleep 2
j while4
endwhile4:
j while1
aim:
s d0 Horizontal r0
s d0 Vertical r1
while5:
l r2 d0 Horizontal
sub r2 r2 r0
abs r2 r2
bgt r2 0.5 or1
l r2 d0 Vertical
sub r2 r2 r1
abs r2 r2
bgt r2 0.5 skip2
j endwhile5
skip2:
or1:
yield
j while5
endwhile5:
move r2 0
while6:
l r3 d0 SignalStrength
bne r3 -1 endwhile6
blt r2 5 skip3
j endwhile6
skip3:
sleep 1
add r2 r2 1
j while6
endwhile6:
l r2 d0 SignalStrength
s d2 Setting r2
s d3 Setting r0
s d4 Setting r1
j ra
fineTune:
push ra
l r5 d0 SignalStrength
add r0 r0 r3
add r0 r0 360
div r6 r0 360
trunc r6 r6
mul r6 r6 360
sub r0 r0 r6
add r1 r1 r4
max r1 0 r1
min r1 90 r1
push r2
push r3
push r4
push r5
jal aim
pop r5
pop r4
pop r3
pop r2
l r6 d0 SignalStrength
beq r6 -1 or2
bgt r6 r5 skip4
j else2
skip4:
or2:
sub r0 r0 r3
add r0 r0 360
div r3 r0 360
trunc r3 r3
mul r3 r3 360
sub r0 r0 r3
sub r1 r1 r4
max r1 0 r1
min r1 90 r1
push r2
jal aim
pop r2
else2:
pop ra
j ra
