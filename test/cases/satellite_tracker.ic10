s d0 Vertical 45
s d0 Horizontal 0
while1:
l r0 d0 SignalStrength
bne r0 -1 endwhile1
move r0 STR("init.")
jal debug
sleep 0.25
move r0 STR("init ")
jal debug
jal display
j while1
endwhile1:
while2:
l r0 d0 SignalStrength
blt r0 2 skip1
j endwhile2
skip1:
move r0 STR("Scan")
jal debug
move r0 20
move r1 0
jal moveDish
j while2
endwhile2:
while3:
l r0 d0 SignalStrength
blt r0 97 skip2
j endwhile3
skip2:
move r0 STR("Fine")
jal debug
move r2 0
move r3 1
jal adjust
move r2 0
move r3 -1
jal adjust
move r2 1
move r3 0
jal adjust
move r2 -1
move r3 0
jal adjust
jal display
j while3
endwhile3:
move r0 STR("Done!")
jal debug
j end
debug:
s d5 Mode 10
s d5 Setting r0
sleep 2
j ra
display:
l r0 d0 SignalStrength
s d2 Setting r0
l r0 d0 Horizontal
s d3 Setting r0
j ra
moveDish:
push ra
l r4 d0 Horizontal
add r0 r4 r0
s d0 Horizontal r0
l r0 d0 Vertical
add r0 r0 r1
s d0 Vertical r0
while4:
l r0 d0 SignalStrength
bne r0 -1 endwhile4
jal display
move r0 STR("move.")
jal debug
sleep 0.25
move r0 STR("move ")
jal debug
j while4
endwhile4:
move r0 STR("stop")
jal debug
sleep 1
jal display
pop ra
j ra
adjust:
push ra
l r0 d0 SignalStrength
move r5 r0
move r0 r2
move r1 r3
jal moveDish
l r0 d0 SignalStrength
blt r0 r5 skip3
j else1
skip3:
sub r0 0 r2
sub r1 0 r3
jal moveDish
else1:
pop ra
j ra
end:
