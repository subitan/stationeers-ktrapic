# The in-game plugin builds with dotnet, not Bazel. Its list of the SDK's generated names is
# made by //tools/datagen, whose test checks it is up to date.
exports_files(
    ["src/SdkNames.g.cs"],
    visibility = ["//tools/datagen:__pkg__"],
)

# bazel run //mod:install -- <mods-dir> [--local-compiler]: builds the plugin and installs it into
# StationeersLaunchPad's local mods directory (see README.md).
alias(
    name = "install",
    actual = "//mod/install",
)
