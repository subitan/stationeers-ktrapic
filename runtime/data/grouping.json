  "notFamilies": [
    {
      "prefabs": ["StructureLogicSwitch", "StructureLogicSwitch2"],
      "reason": "the game names the Lever and the Switch as two devices, not two kinds of one; they differ only in model, with the same logic"
    },
    {
      "prefabs": ["ItemBeacon", "StructureBeacon"],
      "reason": "the Tracking Beacon (an item) and the Beacon (a structure) are different devices"
    },
    {
      "prefabs": [
        ["ItemBatteryCell", "ItemBatteryCellLarge", "ItemBatteryCellNuclear"],
        ["Battery_Wireless_cell", "Battery_Wireless_cell_Big", "ItemWirelessBatteryCellExtraLarge"]
      ],
      "reason": "the game names the Battery Cells and the Wireless Battery Cells as two kinds, each with sizes of its own"
    },
    {
      "prefabs": [["StructureAirlock", "StructureAirlockWide"], "StructureAirlockGate"],
      "reason": "StructureAirlockGate is the game's Small Hangar Door, a 1 x 1 hangar door piece, not an airlock"
    },
    {
      "prefabs": ["StructureGlassDoor", "StructureInteriorDoorGlass"],
      "reason": "the Glass Door is a door of its own, like the Composite Door, and not one of the Interior Doors"
    },
    {
      "prefabs": [
        ["StructurePressureRegulator", "StructureLiquidPressureRegulator"],
        ["StructureBackPressureRegulator", "StructureBackLiquidPressureRegulator"]
      ],
      "reason": "a Pressure Regulator holds its outlet at the setting, a Back Pressure Regulator opens when its inlet reaches it"
    },
    {
      "prefabs": [
        ["StructureValve", "StructureLiquidValve"],
        ["StructurePipeOneWayValveLever", "StructurePipeLiquidOneWayValveLever"],
        "StructureCondensationValve",
        "StructureExpansionValve"
      ],
      "reason": "the Valve, the One Way Valve, the Condensation Valve and the Expansion Valve are different devices with a valve's logic"
    },
    {
      "prefabs": [
        ["StructureMediumRadiator", "StructureMediumRadiatorLiquid"],
        ["StructureMediumConvectionRadiator", "StructureMediumConvectionRadiatorLiquid"],
        ["StructurePassiveLargeRadiatorGas", "StructurePassiveLargeRadiatorLiquid"]
      ],
      "reason": "the Medium Radiator radiates heat into a vacuum, the convection radiators exchange it with the air around them, and StructurePassiveLargeRadiator is an older convection radiator the game says was replaced"
    },
    {
      "prefabs": ["StructureChuteBin", "StructureChuteExportBin"],
      "reason": "the Chute Import Bin passes items into a chute network, the Chute Export Bin takes them out of it"
    },
    {
      "prefabs": [
        "StructureLogicReader",
        "StructureLogicSlotReader",
        "StructureLogicReagentReader",
        "StructureLogicBatchReader",
        "StructureLogicBatchSlotReader"
      ],
      "reason": "each reader reads something different: a device, a slot, reagents, a batch of devices, or a batch of slots"
    },
    {
      "prefabs": ["StructureLogicWriter", "StructureLogicBatchWriter"],
      "reason": "the Logic Writer writes one device, the Batch Writer every device of a kind"
    },
    {
      "prefabs": ["StructureLogicMath", "StructureLogicMathUnary"],
      "reason": "Logic Math takes two inputs, Math Unary one: different devices"
    },
    {
      "prefabs": ["StructurePowerTransmitter", "StructurePowerTransmitterReceiver"],
      "reason": "the Microwave Power Transmitter sends power, the Microwave Power Receiver takes it in"
    }
  ],
  "textDisplays": [
    "StructureConsoleLED5",
    "StructureConsoleLED1x2",
    "StructureConsoleLED1x3"
  ]
