  "notFamilies": [
    {
      "prefabs": ["ItemBeacon", "StructureBeacon"],
      "reason": "the Tracking Beacon (an item) and the Beacon (a structure) are different devices"
    },
    {
      "prefabs": [["StructureAirlock", "StructureAirlockWide"], "StructureAirlockGate"],
      "reason": "StructureAirlockGate is the game's Small Hangar Door, a 1 x 1 hangar door piece, not an airlock"
    },
    {
      "prefabs": [
        ["StructureGlassDoor", "StructureBlastDoor", "StructureCompositeDoor"],
        ["StructureInteriorDoorGlass", "StructureInteriorDoorPadded", "StructureInteriorDoorPaddedThin", "StructureInteriorDoorTriangle"]
      ],
      "reason": "the Glass Door is one of the Doors, like the Blast and Composite Doors, and not one of the Interior Doors, which extend them"
    },
    {
      "prefabs": [["StructureSleeper", "StructureSleeperLeft", "StructureSleeperRight", "StructureSleeperVertical"], "StructureSleeperVerticalDroid"],
      "reason": "the Droid Sleeper recharges robots and harms anyone else who enters, so it is not a sleeper for players; it has no EntityState, Maximum, Ratio or Setting"
    },
    {
      "prefabs": [["StructureCargoStorageSmall", "StructureCargoStorageMedium", "StructureSDBSilo"], "StructureAdvancedComposter"],
      "reason": "the Advanced Composter holds items only while it turns them into fertilizer; it is a processor, not storage"
    },
    {
      "prefabs": [["StructureRoboticArmDock", "StructureLarreDockAtmos", "StructureLarreDockCargo", "StructureLarreDockCollector", "StructureLarreDockHydroponics"], "StructureLarreDockBypass"],
      "reason": "the LArRE Dock (Bypass) is a siding an arm moves into so others can pass, not a dock that works; it has no Activate, Error, Extended, Idle, Position or Setting"
    },
    {
      "prefabs": [["ItemSpaceHelmet", "ItemEmergencySpaceHelmet", "ItemHardsuitHelmet", "ItemIcarusHelmet", "ItemSuitHelmetHARM"], "ItemGasMask"],
      "reason": "the Gas Mask has a helmet's breathing gas and alerts but no visor or power (Lock, On, Open, Power), so grouping it would take those from every helmet"
    },
    {
      "prefabs": [["StructurePressureFedGasEngine", "StructurePressureFedLiquidEngine", "StructurePressureFedGasEngineHeavy", "StructurePressureFedLiquidEngineHeavy", "StructureGovernedGasEngine", "StructurePumpedLiquidEngine"], "StructureRocketEngineTiny"],
      "reason": "the Rocket Engine (Tiny) has no Throttle or PassedMoles, so a program driving a rocket engine can't drive it; its logic is a valve's"
    }
  ],
  "textDisplays": [
    "StructureConsoleLED5",
    "StructureConsoleLED1x2",
    "StructureConsoleLED1x3"
  ]
}
